# Copy to .env.local and fill in. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in emails and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional). Without Gmail or Resend set, emails are printed to the server log.
# In Vercel, paste only the value (no quotes, no NAME=), then redeploy.
#
# Option A: Gmail (recommended, free, reaches customers without a domain).
# Emails are sent from this Gmail address. Needs 2-Step Verification on the
# account; create the app password at https://myaccount.google.com/apppasswords
# (it stops working if the Google password is changed; make a new one then).
# When both are set, Gmail is used and the Resend settings below are ignored.
# S-Villa uses society22ph@gmail.com for both GMAIL_USER and OWNER_NOTIFICATION_EMAIL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Owner alerts go to OWNER_NOTIFICATION_EMAIL (can be the same Gmail address).
#
# Option B: Resend. Free setup without a domain:
#   RESEND_API_KEY            the owner's Resend API key (starts with re_)
#   EMAIL_FROM                S-Villa <onboarding@resend.dev>
#   OWNER_NOTIFICATION_EMAIL  the exact address the owner signed up to Resend with
#   EMAIL_REDIRECT_TO         leave unset
# Resend's test sender only delivers to the account's own address, so the owner
# gets every owner alert and customer emails are skipped (logged as SKIPPED).
# Customers follow their booking on its status page / Find my booking instead.
#
# Testing: set EMAIL_REDIRECT_TO to the Resend account's address to receive the
# customer emails too, marked "[Test → customer]". Remove it afterwards.
#
# With a verified domain: EMAIL_FROM="S-Villa <bookings@your-domain.com>" and
# EMAIL_REDIRECT_TO unset; customer emails are then sent normally.
RESEND_API_KEY=
EMAIL_FROM="S-Villa <onboarding@resend.dev>"
EMAIL_REDIRECT_TO=
# Where owner alerts go. Defaults to the contact email set in the Owner Portal.
OWNER_NOTIFICATION_EMAIL=

# SMS via Semaphore (optional, Philippines). Leave empty to disable SMS.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Protects /api/cron/expire. Use a long random string.
CRON_SECRET=
