# Copy to .env.local and fill in. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used in emails and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional). Without a key, emails are printed to the server log.
RESEND_API_KEY=
# Until your domain is verified in Resend, use the sandbox sender:
#   EMAIL_FROM="S-Villa <onboarding@resend.dev>"
# It only delivers to your Resend signup address, so also set EMAIL_REDIRECT_TO
# to that address. Every email then goes there, marked with its real recipient.
# Clear EMAIL_REDIRECT_TO once the domain is verified.
EMAIL_FROM="S-Villa <bookings@your-domain.com>"
EMAIL_REDIRECT_TO=
# Where owner alerts go. Defaults to the contact email set in the Owner Portal.
OWNER_NOTIFICATION_EMAIL=

# SMS via Semaphore (optional, Philippines). Leave empty to disable SMS.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Protects /api/cron/expire. Use a long random string.
CRON_SECRET=
